APP_NAME="USSCOS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://os.usscos.com
APP_KEY=

# Document root of the public marketing site, when it is deployed separately from
# this application. Leave unset if the two live together.
#   cPanel: /home/t2a2ymc1f3z4/public_html/usscos.com
#   Droplet: /var/www/usscos.com
PUBLIC_SITE_PATH=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usscos
DB_USERNAME=usscos
DB_PASSWORD=

SESSION_LIFETIME=120
SESSION_SECURE=true

MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@usscproducts.com
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

LOG_LEVEL=error
LOG_CHANNEL=file

STORAGE_PATH=storage

# Enable only after migration 111 and fulfillment workflow review.
FULFILLMENT_V2_ENABLED=false

# ---------------------------------------------------------------- lead webhook
# Shared secret for POST /webhook/lead, sent as the X-USSCOS-Secret header.
#
# usscos.com's forms read this value straight out of this file, so they follow a change
# with no action. The WordPress snippet on usscproducts.com holds its own copy and has to
# be pasted by hand - which is why PREVIOUS exists.
LEAD_WEBHOOK_SECRET=

# The secret being retired. Accepted alongside the current one so a rotation does not have
# to reach every sender at the same instant. Every use is logged with the sender, so you
# can see which one still needs updating. Clear it once that log goes quiet.
LEAD_WEBHOOK_SECRET_PREVIOUS=

# Whether a secret is REQUIRED rather than merely checked when sent.
#
# This is the setting that protects the endpoint. While it is false, a request with no
# secret at all is accepted, so a leaked secret costs nothing to work around - omit it.
# Turn it on only once "no secret sent" has stopped appearing in the error log; doing it
# while a sender is still silent takes live lead capture down, as happened on 13 Nov 2026.
LEAD_WEBHOOK_REQUIRE_SECRET=false
