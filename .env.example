APP_NAME="USSCOS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://os.usscos.com
APP_KEY=

# Document root of the public marketing site, when it is deployed separately from
# this application. Leave unset if the two live together.
#   cPanel: /home/t2a2ymc1f3z4/public_html/usscos.com
#   Droplet: /var/www/usscos.com
PUBLIC_SITE_PATH=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usscos
DB_USERNAME=usscos
DB_PASSWORD=

SESSION_LIFETIME=120
SESSION_SECURE=true

# Mail goes out through the SMTP2GO API - there is no SMTP transport, so there is no host,
# port, username or password to set. MAIL_HOST and friends used to be here and were read
# into properties nothing used; a setting that appears to control something and does not is
# worse than a missing one, because it gets changed in the belief that it will help.
MAIL_FROM_ADDRESS=noreply@usscproducts.com
MAIL_FROM_NAME="${APP_NAME}"

# The usscproducts.com SMTP2GO account, which the website and stencil shop also send with.
# Without this, no mail is sent at all and Mailer::send() reports why.
SMTP2GO_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

LOG_LEVEL=error
LOG_CHANNEL=file

STORAGE_PATH=storage

# Enable only after migration 111 and fulfillment workflow review.
FULFILLMENT_V2_ENABLED=false

# ---------------------------------------------------------------- lead webhook
# Shared secret for POST /webhook/lead, sent as the X-USSCOS-Secret header.
#
# usscos.com's forms read this value straight out of this file, so they follow a change
# with no action. The WordPress snippet on usscproducts.com holds its own copy and has to
# be pasted by hand - which is why PREVIOUS exists.
LEAD_WEBHOOK_SECRET=

# The secret being retired, accepted alongside the current one.
#
# DO NOT CLEAR IT without checking who is still using it. As at 24 Nov 2026 the live
# production site usscproducts.com posts real customer leads with this secret and is
# deliberately not being changed. Clearing it stops those leads arriving, and it fails
# silently - the visitor sees success, CF7 sends its email, and the lead never gets here.
# Every use is logged with the sender's address and user agent.
LEAD_WEBHOOK_SECRET_PREVIOUS=

# Whether a secret is REQUIRED rather than merely checked when sent.
#
# This is the setting that protects the endpoint: while it is false, a request with no
# secret at all is accepted, so a leaked secret costs nothing to work around - omit it.
#
# As at 24 Nov 2026 it must stay false. The precondition is not "the log went quiet", it
# is: every sender has been given the CURRENT secret, confirmed by the log showing neither
# "no secret sent" nor "PREVIOUS secret used". Enabling it early takes live lead capture
# down, as happened on 13 Nov 2026.
LEAD_WEBHOOK_REQUIRE_SECRET=false
