APP_NAME="USSCOS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://os.usscos.com
APP_KEY=

# Document root of the public marketing site, when it is deployed separately from
# this application. Leave unset if the two live together.
#   cPanel: /home/t2a2ymc1f3z4/public_html/usscos.com
#   Droplet: /var/www/usscos.com
PUBLIC_SITE_PATH=

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=usscos
DB_USERNAME=usscos
DB_PASSWORD=

SESSION_LIFETIME=120
SESSION_SECURE=true

MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@usscproducts.com
MAIL_FROM_NAME="${APP_NAME}"

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

LOG_LEVEL=error
LOG_CHANNEL=file

STORAGE_PATH=storage
